<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector launcher icon. Using a vector drawable (rather than density-specific
  PNGs) keeps the repo binary-free and scales crisply on every screen. A folder
  silhouette with code brackets signals "developer file explorer".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded background -->
    <path
        android:fillColor="#00696E"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Folder body -->
    <path
        android:fillColor="#6FF6FE"
        android:pathData="M30,38h18l6,7h24a4,4 0 0 1 4,4v30a4,4 0 0 1 -4,4H30a4,4 0 0 1 -4,-4V42a4,4 0 0 1 4,-4z" />

    <!-- Code brackets: &lt;/&gt; -->
    <path
        android:fillColor="#00373A"
        android:strokeColor="#00373A"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M47,58 L41,65 L47,72" />
    <path
        android:fillColor="#00373A"
        android:strokeColor="#00373A"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M61,58 L67,65 L61,72" />
    <path
        android:strokeColor="#00373A"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M56,55 L52,75" />
</vector>
