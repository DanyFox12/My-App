<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground layer. The folder + code-brackets sit inside the
  central 72dp safe zone so no launcher mask (circle, squircle, rounded square)
  ever clips them. Background lives in ic_launcher_background.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Folder tab + body -->
    <path
        android:fillColor="#B8FBFF"
        android:pathData="M32,40h16l6,7h22a4,4 0 0 1 4,4v27a4,4 0 0 1 -4,4H32a4,4 0 0 1 -4,-4V44a4,4 0 0 1 4,-4z" />

    <!-- Code brackets: &lt; / &gt; -->
    <path
        android:strokeColor="#00373A"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M48,58 L42,65 L48,72" />
    <path
        android:strokeColor="#00373A"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M62,58 L68,65 L62,72" />
    <path
        android:strokeColor="#00373A"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M57,56 L53,74" />
</vector>
