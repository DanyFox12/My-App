<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared at this stage. File access will go through the
      Storage Access Framework (which needs NO storage permission — the OS grants
      per-URI access via the picker). Network stays absent until the opt-in sync
      feature is built. This empty permission set is itself part of the safety
      story (docs/ARCHITECTURE.md §10).
    -->

    <application
        android:name=".DevExplorerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DevExplorer.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider lets us share Workspace files with other apps via a
          content:// Uri and a temporary read grant — without exposing a raw
          file path. Scoped to the workspace sandbox by @xml/file_paths.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
