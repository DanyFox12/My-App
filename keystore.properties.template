# Release signing configuration — TEMPLATE.
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill in the
# values, OR export the equivalent environment variables in CI:
#
#   storeFile     -> DEVEXPLORER_KEYSTORE
#   storePassword -> DEVEXPLORER_KEYSTORE_PASSWORD
#   keyAlias      -> DEVEXPLORER_KEY_ALIAS
#   keyPassword   -> DEVEXPLORER_KEY_PASSWORD
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore devexplorer-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias devexplorer
#
# If none of these are provided, `./gradlew assembleRelease` still builds an
# UNSIGNED release APK (useful for verifying R8), but it can't be installed on a
# device until it's signed.

storeFile=devexplorer-release.jks
storePassword=
keyAlias=devexplorer
keyPassword=
